{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/api/products$",
      "dest": "/api/products.js"
    },
    {
      "src": "^/api/orders/(?<id>[^/]+)$",
      "dest": "/api/orders.js?id=$id"
    },
    {
      "src": "^/api/orders$",
      "dest": "/api/orders.js"
    },
    {
      "src": "^/api/enquiries$",
      "dest": "/api/enquiries.js"
    },
    {
      "src": "^/api/settings$",
      "dest": "/api/settings.js"
    },
    {
      "src": "^/api/upload$",
      "dest": "/api/upload.js"
    },
    {
      "src": "^/admin$",
      "dest": "/public/admin.html"
    },
    {
      "src": "^/styles\\.css$",
      "dest": "/public/styles.css"
    },
    {
      "src": "^/app\\.js$",
      "dest": "/public/app.js"
    },
    {
      "src": "^/admin\\.js$",
      "dest": "/public/admin.js"
    },
    {
      "src": "^/images/(.*)$",
      "dest": "/public/images/$1"
    },
    {
      "src": "^/$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/public/$1"
    }
  ]
}
